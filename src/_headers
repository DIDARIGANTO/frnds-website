# Заголовки для хостинга (Cloudflare Pages, Netlify читают этот файл сами).

# Картинки, шрифты и стили названы так, что при изменении меняется имя файла,
# поэтому их можно кешировать надолго — гость не будет качать их заново.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Стили и скрипты меняются при правках сайта — кешируем на сутки.
/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# Сами страницы всегда проверяем на свежесть: цена в меню могла измениться.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
